<Page x:Class="PollingClient.src.ChannelListPage"
   xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
   xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
   Background="White">

    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="90"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
            Background="White"
            BorderBrush="#E5E5E5"
            BorderThickness="0,0,0,1">

            <Grid Margin="30,0">

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <TextBlock x:Name="WelcomeText"
                       Grid.Column="0"
                       Text="Welcome username"
                       FontSize="24"
                       FontWeight="SemiBold"
                       Foreground="#222222"
                       VerticalAlignment="Center"
                       Margin="0,0,20,0"/>

                <StackPanel Grid.Column="1"
                        Orientation="Horizontal"
                        VerticalAlignment="Center">

                    <TextBox x:Name="ChannelNameTextBox"
                         Width="140"
                         Height="35"
                         Margin="0,0,8,0"
                         VerticalContentAlignment="Center"
                         Padding="8,0"/>

                    <Button Content="Create"
                        Width="75"
                        Height="35"
                        Margin="0,0,8,0"
                        Click="CreateChannel_Click"/>

                    <Button Content="Sign Out"
                        Width="75"
                        Height="35"
                        Click="SignOut_Click"/>

                </StackPanel>

            </Grid>

        </Border>

        <Grid Grid.Row="1"
          Margin="40,30">

            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="Auto"/>
            </Grid.RowDefinitions>

            <TextBlock Grid.Row="0"
                   Text="Channels"
                   FontSize="28"
                   FontWeight="SemiBold"
                   Foreground="#222222"
                   Margin="0,0,0,20"/>

            <ListBox x:Name="ChannelList"
                 Grid.Row="1"
                 Background="White"
                 BorderThickness="0">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <Border Background="#F7F7F7"
                            BorderBrush="#E5E5E5"
                            BorderThickness="1"
                            CornerRadius="8"
                            Padding="15"
                            Margin="0,0,0,10"
                            Width="600">

                            <Grid>

                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*"/>
                                    <ColumnDefinition Width="Auto"/>
                                </Grid.ColumnDefinitions>

                                <TextBlock Text="{Binding channelName}"
                                       FontSize="17"
                                       Foreground="#222222"
                                       VerticalAlignment="Center"/>

                                <Button Grid.Column="1"
                                    Content="Join"
                                    Width="80"
                                    Height="32"
                                    Click="Join_Click"/>

                            </Grid>

                        </Border>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </Grid>

    </Grid>

</Page>
