<UserControl x:Class="PollingClient.src.ChannelListView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Background="White">

	<Grid Background="White" Width="485">

		<Grid.RowDefinitions>
			<RowDefinition Height="80"/>
			<RowDefinition Height="*"/>
			<RowDefinition Height="80"/>
		</Grid.RowDefinitions>



		<Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E5E5"
                BorderThickness="0,0,0,1">

			<Grid Margin="30,0">

				<TextBlock x:Name="WelcomeText"
                           Text="Welcome"
                           FontSize="24"
                           FontWeight="SemiBold"
                           Foreground="#222222"
                           VerticalAlignment="Center"/>

				<Button Content="Sign Out"
                        Width="100"
                        Height="35"
                        HorizontalAlignment="Right"
                        VerticalAlignment="Center"
                        Click="SignOut_Click"/>

			</Grid>

		</Border>



		<Grid Grid.Row="1"
              Margin="40,30">

			<Grid.RowDefinitions>
				<RowDefinition Height="Auto"/>
				<RowDefinition Height="*"/>
			</Grid.RowDefinitions>

			<TextBlock Text="Channels"
                       FontSize="28"
                       FontWeight="SemiBold"
                       Foreground="#222222"
                       Margin="0,0,0,20"/>


			<ListBox x:Name="ChannelList"
                     Grid.Row="1"
                     Background="White"
                     BorderThickness="0">

				<ListBox.ItemTemplate>

					<DataTemplate>

						<Border Background="#F7F7F7"
                                BorderBrush="#E5E5E5"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="15"
                                Margin="0,0,0,10">

							<Grid>

								<Grid.ColumnDefinitions>
									<ColumnDefinition Width="*"/>
									<ColumnDefinition Width="Auto"/>
								</Grid.ColumnDefinitions>

								<TextBlock Text="{Binding channelName}"
                                           FontSize="17"
                                           Foreground="#222222"
                                           VerticalAlignment="Center"/>

								<Button Grid.Column="1"
                                        Content="Join"
                                        Width="80"
                                        Height="32"
                                        Click="Join_Click"/>

							</Grid>

						</Border>

					</DataTemplate>

				</ListBox.ItemTemplate>

			</ListBox>

		</Grid>



		<Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E5E5"
                BorderThickness="0,1,0,0">

			<Button Content="Create Channel"
                    Width="140"
                    Height="38"
                    HorizontalAlignment="Right"
                    VerticalAlignment="Center"
                    Margin="0,0,30,0"
                    Click="CreateChannel_Click"/>

		</Border>

	</Grid>

</UserControl>