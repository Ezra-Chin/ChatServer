<Window x:Class="PollingClient.src.PrivateChatWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Private Conversation"
        Width="500"
        Height="600"
        MinWidth="400"
        MinHeight="450"
        Background="White"
        WindowStartupLocation="CenterOwner">

    <Grid Background="White">

        <Grid.RowDefinitions>
            <RowDefinition Height="70"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="65"/>
        </Grid.RowDefinitions>



        <Border Grid.Row="0"
                Background="White"
                BorderBrush="#E5E5E5"
                BorderThickness="0,0,0,1">

            <StackPanel Margin="25,0"
                        VerticalAlignment="Center">

                <TextBlock Text="Private Conversation"
                           FontSize="13"
                           Foreground="#777777"/>

                <TextBlock x:Name="RecipientText"
                           Text="User"
                           FontSize="21"
                           FontWeight="SemiBold"
                           Foreground="#222222"/>

            </StackPanel>

        </Border>



        <Border Grid.Row="1"
                Padding="20"
                Background="White">

            <ListBox x:Name="PrivateMessageList"
                     Background="White"
                     BorderThickness="0">

                <ListBox.ItemTemplate>

                    <DataTemplate>

                        <StackPanel Margin="0,0,0,12">

                            <TextBlock Text="{Binding UserId}"
                                       FontWeight="SemiBold"
                                       Foreground="#333333"/>

                            <TextBlock Text="{Binding Message}"
                                       TextWrapping="Wrap"
                                       Foreground="#555555"/>

                        </StackPanel>

                    </DataTemplate>

                </ListBox.ItemTemplate>

            </ListBox>

        </Border>



        <Border Grid.Row="2"
                Background="White"
                BorderBrush="#E5E5E5"
                BorderThickness="0,1,0,0"
                Padding="15">

            <Grid>

                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="70"/>
                </Grid.ColumnDefinitions>

                <TextBox x:Name="PrivateMessageTextBox"
                         Height="38"
                         Padding="10"
                         VerticalContentAlignment="Center"/>

                <Button Grid.Column="1"
                        Content="Send"
                        Height="38"
                        Margin="10,0,0,0"
                        Click="Send_Click"/>

            </Grid>

        </Border>

    </Grid>

</Window>